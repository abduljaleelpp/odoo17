<odoo>
    <record id="dashboard" model="ir.actions.client">
        <field name="name">Awesome Dashboard</field>
        <field name="tag">awesome_dashboard.dashboard</field>
    </record>
    <record id="active_deals_count" model="ir.actions.client">
        <field name="name">Active Deals Count</field>
